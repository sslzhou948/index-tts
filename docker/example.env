# Example environment configuration for IndexTTS Docker deployment
# Copy this file to .env and modify as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model Configuration
MODEL_DIR=/app/checkpoints
CONFIG_PATH=/app/checkpoints/config.yaml

# CUDA/GPU Configuration
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# Logging Configuration
LOG_LEVEL=INFO

# Performance Tuning
# Uncomment and adjust based on your system
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
# NUMBA_NUM_THREADS=4

# Memory Management
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# HuggingFace Configuration (for model downloads)
# HF_ENDPOINT=https://hf-mirror.com  # Use mirror for faster downloads in China
# HF_HOME=/app/.cache/huggingface
